// The actual installed native Setup window, using synthetic retained backups.
const {app}=require('electron'),assert=require('node:assert/strict');const {mkdtempSync,writeFileSync,existsSync}=require('node:fs'),{tmpdir}=require('node:os'),{join}=require('node:path');
const desktopRoot='/opt/lytguide-test/current/desktop',{createDesktop}=require(join(desktopRoot,'resources/app/main.cjs'));
app.setPath('userData',mkdtempSync(join(tmpdir(),'lytguide-backup-ui-')));app.enableSandbox();app.disableHardwareAcceleration();app.on('window-all-closed',()=>{});const deadline=setTimeout(()=>app.exit(1),120000);
(async()=>{
 await app.whenReady();const desktop=createDesktop({authorizeSetup:async()=>process.env.LYTGUIDE_SETUP_TEST_URL,assetRoot:join(desktopRoot,'resources/lytguide-assets')});await desktop.showSetup();const win=[...desktop.windows][0],evaluate=async code=>{try{return await win.webContents.executeJavaScript(code);}catch(error){throw Error('UI expression failed: '+code+' '+error.message);}};
 const wait=async code=>{for(let n=0;n<400;n++){if(await evaluate(code))return;await new Promise(resolve=>setTimeout(resolve,100));}throw Error('Missing UI state: '+code);};
 const capture=async label=>{for(const [width,height,size]of [[1280,960,'desktop'],[390,844,'mobile']]){win.unmaximize();win.setSize(width,height);await new Promise(resolve=>setTimeout(resolve,150));await evaluate('document.fonts.ready.then(()=>true)');const rect=await evaluate('({width:innerWidth,body:document.documentElement.scrollWidth})');assert.ok(rect.body<=rect.width+1,JSON.stringify(rect));writeFileSync('/tmp/lytguide-backup-'+label+'-'+size+'.png',(await win.webContents.capturePage()).toPNG());}};
 await wait('Boolean(document.querySelector("[data-restore-detected]"))');await capture('found');
 await evaluate('document.querySelector("[data-skip-detected]").click()');await wait('!document.querySelector("[data-restore-detected]")');assert.ok(await evaluate('Boolean(document.querySelector("[data-choose=new]"))'));
 await evaluate('document.querySelector("[data-choose=replace]").click()');await wait('Boolean(document.querySelector("[data-continue=system]"))');await evaluate('document.querySelector("[data-continue=system]").click()');await wait('Boolean(document.querySelector("[data-continue=network]"))');await evaluate('document.querySelector("[name=addressReserved]").checked=true;document.querySelector("[data-continue=network]").click()');
 await wait('Boolean(document.querySelector("#detected-backup"))');await evaluate('document.querySelector("[data-select-detected]").click()');await wait('Boolean(document.querySelector(".file-row p"))');assert.ok(await evaluate('(()=>{const input=document.querySelector("#backup-file");return input?.type==="file"&&input.accept===".lytbackup";})()'));
 // Drive the same native file input as a real user selection, without disabling
 // the application's sandbox or granting renderer file-system privileges.
 win.webContents.debugger.attach('1.3');const tree=await win.webContents.debugger.sendCommand('DOM.getDocument');const query=await win.webContents.debugger.sendCommand('DOM.querySelector',{nodeId:tree.root.nodeId,selector:'#backup-file'});await win.webContents.debugger.sendCommand('DOM.setFileInputFiles',{nodeId:query.nodeId,files:['/home/desktopqa/manual-backup.lytbackup']});win.webContents.debugger.detach();
 assert.equal(await evaluate('document.querySelector("#backup-file").files[0].name'),'manual-backup.lytbackup');await evaluate('document.querySelector("[data-upload]").click()');await wait('document.querySelector("#content").textContent.includes("Selected: manual-backup.lytbackup")');await capture('browse');assert.ok(existsSync('/home/desktopqa/manual-backup.lytbackup'));
 clearTimeout(deadline);console.log('PASS installed native backup prompt, No choice, detected selection, native file input upload, original-file preservation and desktop/mobile layout');app.exit(0);
})().catch(error=>{console.error(error);clearTimeout(deadline);app.exit(1);});
