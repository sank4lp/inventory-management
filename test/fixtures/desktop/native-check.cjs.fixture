// Real Electron integration, using synthetic loopback services and a fake camera.
const {app,BrowserWindow}=require('electron');
const {createServer}=require('node:http');const {mkdtempSync,readFileSync,writeFileSync}=require('node:fs');const {tmpdir}=require('node:os');const {join,dirname}=require('node:path');const assert=require('node:assert/strict');
const root=process.env.LYTGUIDE_DESKTOP_TEST_ROOT||process.argv[2]||'/opt/lytguide-test/current/desktop';
const {createDesktop}=require(process.env.LYTGUIDE_DESKTOP_PRODUCTION||join(root,'resources/app/main.cjs'));
const temp=mkdtempSync(join(tmpdir(),'lytguide-native-check-'));app.setPath('userData',temp);app.enableSandbox();app.commandLine.appendSwitch('disable-gpu');app.commandLine.appendSwitch('use-fake-device-for-media-stream');
app.on('window-all-closed',()=>{});app.on('browser-window-created',(_event,win)=>{win.on('ready-to-show',()=>{win.focus();win.webContents.focus();});});let evidence=null,setupAuthorized=false,setupCookie=false,asked=0,leaveChoice=0;
const deadline=setTimeout(()=>{console.error('FAIL native desktop integration timed out');app.exit(1);},90000);
const wait=async check=>{for(let i=0;i<200;i++){if(await check())return;await new Promise(r=>setTimeout(r,50));}throw Error('Expected desktop state did not appear');};
const base='http://localhost:3325';
const work=createServer(async(req,res)=>{
 if(req.url==='/evidence'){let body='';for await(const part of req)body+=part;evidence=JSON.parse(body);res.end('ok');return;}
 if(req.url==='/download'){res.writeHead(200,{'Content-Type':'text/csv','Content-Disposition':'attachment; filename="stock.csv"'});res.end('product,quantity\nQA,4\n');return;}
 if(req.url==='/work'){res.setHeader('Content-Type','text/html');res.end(`<!doctype html><title>LytGuide work test</title><h1>Warehouse</h1><script>(async()=>{const result={require:typeof require,process:typeof process};try{const stream=await navigator.mediaDevices.getUserMedia({video:true});result.camera=stream.getVideoTracks().length;stream.getTracks().forEach(t=>t.stop());}catch(e){result.cameraError=e.name;}try{await navigator.mediaDevices.getUserMedia({audio:true});result.audio=true;}catch(e){result.audio=false;}await fetch('/evidence',{method:'POST',body:JSON.stringify(result)});})();</script>`);return;}
 res.setHeader('Content-Type','text/html');res.end('<!doctype html><title>Warehouse</title><p>Ready</p>');
});
const setup=createServer(async(req,res)=>{
 if(req.url==='/setup-api/unlock'){
  let body='';for await(const part of req)body+=part;assert.equal(JSON.parse(body).token,'a'.repeat(64));assert.equal(req.headers.origin,'http://localhost:3311');setupAuthorized=true;res.setHeader('Set-Cookie','lytguide_setup='+'b'.repeat(64)+'; Path=/; HttpOnly; SameSite=Strict');res.setHeader('Content-Type','application/json');res.end('{"ok":true}');return;
 }
 setupCookie=String(req.headers.cookie||'').includes('lytguide_setup='+'b'.repeat(64));res.setHeader('Content-Type','text/html');res.end('<!doctype html><title>Warehouse Setup</title><p>Setup ready</p><a href="'+base+'/work">Open LytGuide</a>');
});
(async()=>{
 await Promise.all([new Promise(r=>work.listen(3325,'::',r)),new Promise(r=>setup.listen(3311,'::',r))]);await app.whenReady();
 const controller=createDesktop({readWorkUrl:()=>base+'/work',isPending:()=>false,assetRoot:join(root,'resources/lytguide-assets'),authorizeSetup:async resume=>'http://localhost:3311/#'+'a'.repeat(64),askSync:()=>leaveChoice,ask:async(win,options)=>{if(options.title==='Camera access'){asked++;return {response:0};}return {response:1};}});controller.menu();await controller.openWork();
 const win=[...controller.windows][0];assert.equal(win.webContents.getURL(),base+'/work');assert.equal(win.webContents.getLastWebPreferences().sandbox,true);assert.equal(win.webContents.getLastWebPreferences().contextIsolation,true);assert.equal(win.webContents.getLastWebPreferences().nodeIntegration,false);
 await wait(()=>evidence);assert.deepEqual(evidence,{require:'undefined',process:'undefined',camera:1,audio:false});assert.equal(asked,1);
 await win.webContents.executeJavaScript('navigator.clipboard.writeText("LytGuide QA")',true);assert.equal(await require('electron').clipboard.readText(),'LytGuide QA');assert.equal(await win.webContents.executeJavaScript('navigator.clipboard.readText().then(()=>true,()=>false)',true),false);
 const pdf=await win.webContents.printToPDF({});assert.equal(pdf.subarray(0,4).toString(),'%PDF');
 const download=join(temp,'stock.csv');const downloaded=new Promise((resolve,reject)=>{win.webContents.session.once('will-download',(_event,item)=>{item.setSavePath(download);item.once('done',(_event,state)=>state==='completed'?resolve():reject(Error(state)));});});win.webContents.downloadURL(base+'/download');await downloaded;assert.match(readFileSync(download,'utf8'),/QA,4/);
 console.log('PASS real desktop: isolated renderer, sandbox, explicit video permission, microphone refusal, write-only clipboard, printing and CSV download');
 let leavePrevented=false;win.webContents.emit('will-prevent-unload',{preventDefault(){leavePrevented=true;}});assert.equal(leavePrevented,false);leaveChoice=1;win.webContents.emit('will-prevent-unload',{preventDefault(){leavePrevented=true;}});assert.equal(leavePrevented,true);
 let blocked=false;win.webContents.emit('will-navigate',{preventDefault(){blocked=true;}},'file:///etc/passwd');assert.equal(blocked,true);assert.equal(win.webContents.getURL(),base+'/work');
 const opened=win.webContents.getWindowOpenHandler?.(); // Public state below verifies our own child-window path.
 win.webContents.emit('will-attach-webview',{preventDefault(){blocked=true;}});
 await controller.showSetup();assert.equal(setupAuthorized,true);await wait(()=>setupCookie);const setupWin=[...controller.windows].find(w=>w!==win);assert.ok(setupWin);assert.equal(setupWin.webContents.getURL(),'http://localhost:3311/');assert.equal((await win.webContents.session.cookies.get({name:'lytguide_setup'})).length,0);assert.equal((await setupWin.webContents.session.cookies.get({name:'lytguide_setup'})).length,1);
 await win.loadURL(base+'/setup-not-ready');
 let prevented=false;setupWin.webContents.emit('will-navigate',{preventDefault(){prevented=true;}},base+'/work');assert.equal(prevented,true);await wait(()=>setupWin.isDestroyed());assert.equal(win.isDestroyed(),false);assert.equal(win.webContents.getURL(),base+'/work');
 win.close();assert.equal((await fetch(base+'/login')).status,200);
 console.log('PASS real desktop: Setup authorisation/cookie isolation, internal handoff to warehouse and window close leaves local service running');
 work.close();setup.close();clearTimeout(deadline);app.exit(0);
})().catch(error=>{console.error(error);clearTimeout(deadline);app.exit(1);});
